{
  "name": "nakama-protocol",
  "version": "0.3.1",
  "description": "Public Nakama protocol workspace for the Robinhood-native sponsor-funded Phase 0 implementation, with preserved Solana and Ethereum candidates.",
  "author": "OMEGAX HEALTH FZCO",
  "contributors": [
    "Marino Sabijan, MD"
  ],
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/OmegaX-Health/nakama-protocol.git"
  },
  "homepage": "https://github.com/OmegaX-Health/nakama-protocol#readme",
  "bugs": {
    "url": "https://github.com/OmegaX-Health/nakama-protocol/issues"
  },
  "type": "module",
  "scripts": {
    "ethereum:build": "hardhat build --build-profile production",
    "ethereum:test": "hardhat test mocha --build-profile production",
    "ethereum:contract": "npm run ethereum:build && node scripts/generate_ethereum_contract.mjs",
    "ethereum:contract:check": "npm run ethereum:build && node scripts/generate_ethereum_contract.mjs --check",
    "ethereum:manifest:promote": "npm run ethereum:contract:check && node scripts/promote_ethereum_mainnet_manifest.mjs",
    "ethereum:deploy:preflight": "npm run ethereum:contract:check && node scripts/ethereum_mainnet_preflight.mjs",
    "ethereum:deploy:mainnet": "npm run ethereum:contract:check && hardhat run scripts/deploy_ethereum_mainnet.ts --network mainnet --build-profile production",
    "robinhood:build": "hardhat build --build-profile production",
    "robinhood:test": "hardhat test mocha test/ethereum/robinhood/*.ts --build-profile production",
    "robinhood:contract": "npm run robinhood:build && node scripts/generate_robinhood_contract.mjs",
    "robinhood:contract:check": "npm run robinhood:build && node scripts/generate_robinhood_contract.mjs --check",
    "robinhood:deploy:mainnet:plan": "npm run robinhood:contract:check && node scripts/plan_robinhood_mainnet.mjs",
    "robinhood:deploy:testnet": "npm run robinhood:contract:check && hardhat run scripts/deploy_robinhood_testnet.ts --network robinhoodTestnet --build-profile production",
    "robinhood:generic:testnet:asset:deploy": "npm run ethereum:contract:check && hardhat run scripts/deploy_robinhood_test_settlement_asset.ts --network robinhoodTestnet --build-profile production",
    "robinhood:generic:testnet:release:prepare": "node scripts/prepare_robinhood_generic_testnet_release.mjs",
    "robinhood:generic:testnet:preflight": "npm run ethereum:contract:check && node scripts/robinhood_generic_testnet_preflight.mjs",
    "robinhood:generic:testnet:deploy": "npm run ethereum:contract:check && hardhat run scripts/deploy_robinhood_generic_testnet.ts --network robinhoodTestnet --build-profile production",
    "robinhood:generic:testnet:verify:blockscout": "hardhat verify blockscout --network robinhoodTestnet --build-profile production",
    "robinhood:generic:testnet:verify:sourcify": "hardhat verify sourcify --network robinhoodTestnet --build-profile production",
    "robinhood:generic:testnet:promote": "npm run ethereum:contract:check && node scripts/promote_robinhood_generic_testnet_manifest.mjs",
    "anchor:build": "anchor build",
    "anchor:build:checked": "node scripts/anchor_build_with_stack_gate.mjs",
    "anchor:test": "node scripts/anchor_test_with_stack_gate.mjs",
    "anchor:idl": "npm run anchor:build:checked && mkdir -p idl && cp target/idl/nakama_coverage_protocol.json idl/nakama_coverage_protocol.json && cp target/idl/nakama_private_claim_review.json idl/nakama_private_claim_review.json && node scripts/check_idl_freshness.mjs --write",
    "quasar:check": "cargo check -p nakama_coverage_protocol --features quasar --lib",
    "quasar:discriminators": "node scripts/generate_quasar_discriminators.mjs",
    "idl:freshness:check": "node scripts/check_idl_freshness.mjs",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "rust:test": "cargo test --workspace --lib",
    "rust:lint": "cargo clippy --workspace --all-targets -- -A unexpected_cfgs -A deprecated -A clippy::too_many_arguments -D warnings",
    "qedgen:check": "node scripts/run_qedgen.mjs check",
    "qedgen:check:private-claim-review": "node scripts/check_private_claim_review_qedgen.mjs",
    "qedgen:codegen": "node scripts/run_qedgen.mjs codegen",
    "qedgen:verify": "node scripts/run_qedgen.mjs verify",
    "qedgen:reconcile": "node scripts/run_qedgen.mjs reconcile",
    "certora:solana:check": "node scripts/check_certora_solana.mjs",
    "certora:solana:sanity": "node scripts/run_certora_solana_sanity.mjs",
    "certora:solana:status": "node scripts/query_certora_solana_status.mjs",
    "protocol:contract": "node --import tsx scripts/generate_protocol_contract.ts",
    "protocol:contract:check": "node scripts/check_protocol_contract.mjs",
    "beta:consistency:check": "node scripts/check_beta_consistency.mjs",
    "mvp:consistency:check": "node scripts/check_mvp_consistency.mjs",
    "governance:bootstrap": "node --import tsx scripts/bootstrap_governance_realms.ts",
    "protocol:bootstrap": "node --import tsx scripts/bootstrap_protocol.ts",
    "protocol:bootstrap:devnet-live": "node --import tsx scripts/bootstrap_devnet_live_protocol.ts",
    "protocol:bootstrap:genesis-live": "node --import tsx scripts/bootstrap_genesis_live_protocol.ts",
    "devnet:frontend:bootstrap": "node --import tsx scripts/bootstrap_devnet_frontend_parity.ts",
    "devnet:beta:observe": "node --import tsx scripts/devnet_beta_observability.ts",
    "devnet:beta:deploy": "node --import tsx scripts/deploy_devnet_beta.ts",
    "devnet:frontend:smoke": "node --import tsx scripts/devnet_frontend_role_smoke.ts",
    "devnet:frontend:signoff": "DEVNET_FIXTURE_STRICT=1 node --import tsx scripts/devnet_frontend_role_smoke.ts",
    "devnet:operator:drawer:sim": "node --import tsx scripts/devnet_operator_drawer_sim.ts",
    "devnet:program:redeploy-fresh": "node --import tsx scripts/deploy_fresh_devnet_program.ts",
    "devnet:treasury:seed-canaries": "node --import tsx scripts/seed_devnet_treasury_canaries.ts",
    "devnet:treasury:pen-test": "node --import tsx scripts/devnet_treasury_pen_test.ts",
    "devnet:governance:smoke:create-vote": "node --import tsx scripts/devnet_governance_smoke.ts create-vote",
    "devnet:governance:smoke:execute": "node --import tsx scripts/devnet_governance_smoke.ts execute",
    "devnet:governance:ui:readonly": "node --import tsx scripts/devnet_governance_ui_readonly.ts",
    "devnet:mvp:deploy": "node --import tsx scripts/deploy_devnet_mvp.ts",
    "devnet:magicblock:claim-review": "node --import tsx scripts/devnet_magicblock_claim_review_smoke.ts",
    "schema:metadata-hash": "node --import tsx scripts/generate_schema_metadata_hash.ts",
    "schema:rule-hashes": "node --import tsx scripts/generate_outcome_rule_hashes.ts",
    "schema:generate-standard": "node --import tsx scripts/generate_standard_health_outcomes_schema.ts",
    "genesis:actuarial:review": "node --import tsx scripts/genesis_actuarial_review.ts",
    "nomad:curve:poc": "node --import tsx scripts/nomad_curve_actuarial_poc.ts",
    "frontend:install": "npm --prefix frontend ci",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:dev:reset": "pkill -f \"[n]ext dev\" || true; rm -rf frontend/.next frontend/.next-dev-*; npm run frontend:dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:workbench:mobile-sidebar:smoke": "node --import tsx scripts/protocol_workbench_mobile_sidebar_smoke.ts",
    "frontend:start": "npm --prefix frontend run start",
    "test:node": "node --import tsx --test $(find tests -type f -name '*.test.ts' | sort)",
    "test:e2e:localnet": "node scripts/run_localnet_e2e.mjs",
    "semantic:readiness:check": "node scripts/check_semantic_readiness.mjs",
    "public:hygiene:check": "node scripts/check_public_repo_hygiene.mjs",
    "license:audit": "node scripts/check_dependency_licenses.mjs",
    "security:audit:deps": "node scripts/check_dependency_advisories.mjs",
    "security:sbom": "node scripts/generate_sbom.mjs",
    "ci:public": "npm run rust:fmt:check && npm run rust:test && npm run rust:lint && npm run quasar:check && npm run idl:freshness:check && npm run protocol:contract:check && npm run robinhood:contract:check && npm run robinhood:test && npm run test:node && npm run frontend:build && npm run semantic:readiness:check && npm run public:hygiene:check",
    "verify:public": "npm run ci:public && npm run license:audit && npm run security:audit:deps && npm run security:sbom",
    "doctor": "node scripts/doctor.mjs",
    "verify": "npm run doctor && npm run ci:public"
  },
  "dependencies": {
    "@solana/spl-governance": "^0.3.28",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^20.19.37",
    "ethers": "^6.17.0",
    "hardhat": "^3.10.0",
    "license-checker": "25.0.1",
    "playwright": "^1.58.2",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "form-data": "4.0.6",
    "ws": "8.21.0",
    "uuid": "14.0.0"
  }
}
